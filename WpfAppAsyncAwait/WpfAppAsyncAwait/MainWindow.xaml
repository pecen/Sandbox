<Window x:Class="WpfAppAsyncAwait.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppAsyncAwait"
        mc:Ignorable="d"
        Title="Async/Await Demo" Height="200" Width="400">
    <StackPanel Margin="20">
        <Button Content="Synkron (Fryser UI)" 
                Click="SyncButton_Click" 
                Margin="0,0,0,10"/>
        <Button Content="Asynkron (Responsivt UI)" 
                Click="AsyncButton_Click" 
                Margin="0,0,0,10"/>
        <TextBlock x:Name="StatusText" FontSize="16"/>
    </StackPanel>
</Window>
